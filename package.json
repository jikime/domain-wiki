{
  "name": "my-domain-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait && node scripts/init-local-db.mjs",
    "db:stop": "docker compose --env-file .env.local stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "test:official": "node --import tsx scripts/check-official-fetch.mjs",
    "env:check": "node --conditions=react-server --import tsx scripts/check-env.ts",
    "predev": "npm run env:check",
    "prestart": "npm run env:check",
    "evaluation:check": "node scripts/check-evaluation.mjs",
    "evaluation:parsers": "node --import tsx scripts/evaluate-parsers.ts",
    "worker": "node --conditions=react-server --import tsx src/worker/index.ts",
    "db:content-team": "node --conditions=react-server --import tsx scripts/provision-content-team.ts",
    "test:reference": "vitest run --config vitest.reference.config.ts",
    "test:ai": "vitest run --config vitest.ai.config.ts",
    "test:workbook": "node --conditions=react-server --import tsx --test src/server/workbook.test.ts",
    "model:check-cli": "node --conditions=react-server --import tsx scripts/check-model-cli.ts",
    "native:build": "cargo build --release --locked --manifest-path native/document-extract/Cargo.toml",
    "native:test": "cargo test --locked --manifest-path native/document-extract/Cargo.toml"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@milkdown/kit": "7.22.1",
    "@next/env": "16.3.4",
    "@react-sigma/core": "5.0.6",
    "@xmldom/xmldom": "0.9.12",
    "better-auth": "1.7.3",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.2",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "ipaddr.js": "2.5.0",
    "js-yaml": "^4.1.1",
    "jszip": "3.10.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.43.0",
    "mermaid": "^11.14.0",
    "next": "16.3.4",
    "officeparser": "7.8.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "sigma": "3.0.2",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "officeparser": {
      "pdfjs-dist": "6.3.289"
    }
  }
}
