# npm run setup:local creates .env.local with random secrets. Never commit it.
DATABASE_URL=postgresql://domain_wiki:CHANGE_ME@127.0.0.1:55433/domain_wiki
TEST_DATABASE_URL=postgresql://domain_wiki:CHANGE_ME@127.0.0.1:55433/domain_wiki_test
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
DB_PORT=55433
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3010
# Server-only model settings. Keep secrets out of browser/client variables.
# api | claude-code | codex-cli. 기본값은 기존 API 연결입니다.
AI_TRANSPORT=api
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# 용도별 값은 비워두면 위 공통 설정을 사용합니다.
AI_CHAT_TRANSPORT=
AI_CHAT_BASE_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
AI_KNOWLEDGE_TRANSPORT=
AI_KNOWLEDGE_BASE_URL=
AI_KNOWLEDGE_MODEL=
AI_KNOWLEDGE_API_KEY=
# 이미지 설명은 멀티모달 모델을 명시한 경우에만 실행합니다.
AI_VISION_TRANSPORT=
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_CONTEXT_CHARS=48000
# CLI는 서버 운영 계정에 별도로 설치·인증합니다. 실행 파일명 또는 절대 경로만 지정합니다.
AI_CLAUDE_CLI_BIN=claude
AI_CODEX_CLI_BIN=codex
# 웹 서버/작업자 프로세스별 CLI 실행 한도. 대기 시간도 AI_TIMEOUT_SECONDS에 포함합니다.
AI_CLI_MAX_CONCURRENT=1
# 예: AI_TRANSPORT=claude-code, AI_MODEL=sonnet (AI_BASE_URL/AI_API_KEY 불필요)
# 예: 공통 API 유지 + AI_CHAT_TRANSPORT=codex-cli + AI_CHAT_MODEL=사용할_Codex_모델
# CLI 인증 방식에 따른 과금·구독 이용 조건과 혼용 예시는 docs/MODEL_TRANSPORTS.md를 참고하세요.
# PDF OCR: disabled | local | cloud. local은 운영자가 설치한 MinerU 서버를 사용합니다.
MINERU_BACKEND=disabled
MINERU_ENDPOINT=http://127.0.0.1:8000
MINERU_LOCAL_TOKEN=
MINERU_API_KEY=
MINERU_MODEL_VERSION=pipeline
MINERU_LOCAL_BACKEND=hybrid-engine
MINERU_LANGUAGE=korean
MINERU_PARSE_METHOD=auto
MINERU_MODEL_SERVER_URL=
# 로컬에서는 npm run native:build. Docker 이미지는 변환기를 포함합니다.
DOCUMENT_EXTRACTOR_BIN=
# 모델 토큰 한도와 별개인 서버 입력 문자 수 상한입니다.
AI_CHAT_CONTEXT_CHARS=120000
AI_KNOWLEDGE_CONTEXT_CHARS=48000
AI_TASK_LEASE_SECONDS=30
ORIGINALS_DIR=.local/originals
JOB_LEASE_SECONDS=120

AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENT=3
# 스트리밍 사용량을 지원하지 않는 호환 공급자는 false로 지정합니다.
AI_INCLUDE_USAGE=true

# OpenAI를 쓰는 경우 AI_BASE_URL / AI_MODEL / AI_API_KEY를 비워두고 설정합니다.
# OPENAI_API_KEY만 입력하면 아래 주소·모델을 사용합니다. 키가 비어 있으면 미연결입니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 작업공간별 서버 폴더 연결. 운영자는 경로를 읽기 전용으로 마운트하세요.
# [{"key":"team","label":"팀 자료","path":"/mnt/team","workspaceId":"작업공간-UUID"}]
SOURCE_IMPORT_ROOTS=[]

# 심층 조사 검색 제공자. 브라우저에 키를 전달하지 않습니다.
# provider: tavily, firecrawl, searxng, ollama, brave, bocha, serpapi
# baseUrl은 운영자가 관리하는 검색 API의 기본 주소입니다.
# workspaceIds를 생략하면 모든 작업공간에서 사용할 수 있습니다.
# 예: [{"provider":"tavily","apiKey":"REPLACE_ME","workspaceIds":["WORKSPACE_UUID"]}]
RESEARCH_SEARCH_PROVIDERS=[]
# Tavily를 쓰려면 키를 넣고 위 RESEARCH_SEARCH_PROVIDERS를 아래 예시로 변경합니다.
# Next.js와 작업자의 @next/env가 같은 파일의 키 참조를 해석합니다.
# RESEARCH_SEARCH_PROVIDERS='[{"provider":"tavily","apiKey":"${TAVILY_API_KEY}","workspaceIds":["WORKSPACE_UUID"]}]'
TAVILY_API_KEY=
